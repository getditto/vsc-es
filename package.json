{
  "name": "ditto-vsce",
  "displayName": "Ditto Edge Studio",
  "description": "Debug and inspect Ditto databases from VS Code.",
  "version": "0.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getditto/vsc-es.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "publisher": "ditto",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dittoVsce",
          "title": "Ditto",
          "icon": "resources/ditto-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dittoInspector",
          "title": "Ditto Inspector",
          "icon": "resources/ditto-icon.svg"
        }
      ]
    },
    "views": {
      "dittoVsce": [
        {
          "id": "dittoDatabases",
          "name": "Connections"
        },
        {
          "id": "dittoLogging",
          "name": "Logging"
        },
        {
          "id": "dittoHelp",
          "name": "Help"
        }
      ],
      "dittoInspector": [
        {
          "type": "webview",
          "id": "dittoVsce.inspector",
          "name": "Inspector"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dittoDatabases",
        "contents": "No Ditto connections yet.\n\nNew to Ditto? Take the guided tour to set up your first connection.\n[Open Welcome](command:dittoVsce.openWelcome)\n\nAlready have Portal credentials?\n[Register Connection…](command:dittoVsce.registerDatabase)"
      }
    ],
    "commands": [
      {
        "command": "dittoVsce.registerDatabase",
        "title": "Register Connection…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.editDatabase",
        "title": "Edit Configuration",
        "icon": "$(edit)"
      },
      {
        "command": "dittoVsce.deleteDatabase",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.connect",
        "title": "Connect"
      },
      {
        "command": "dittoVsce.disconnect",
        "title": "Disconnect"
      },
      {
        "command": "dittoVsce.openPeerListing",
        "title": "Open Peer Listing"
      },
      {
        "command": "dittoVsce.newSubscription",
        "title": "New Subscription…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.deleteSubscription",
        "title": "Delete Subscription",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.editSubscription",
        "title": "Edit Subscription",
        "icon": "$(edit)"
      },
      {
        "command": "dittoVsce.newObserver",
        "title": "New Observer…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.editObserver",
        "title": "Edit Observer"
      },
      {
        "command": "dittoVsce.deleteObserver",
        "title": "Delete Observer",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.openObserver",
        "title": "Open Observer"
      },
      {
        "command": "dittoVsce.importSubscriptionsFromServer",
        "title": "Ditto: Import Subscriptions from Server…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dittoVsce.openQueryEditor",
        "title": "Open Query Editor"
      },
      {
        "command": "dittoVsce.openQueryMetrics",
        "title": "Open Query Metrics",
        "icon": "$(dashboard)"
      },
      {
        "command": "dittoVsce.openDatabaseMetrics",
        "title": "Open Database Metrics",
        "icon": "$(pie-chart)"
      },
      {
        "command": "dittoVsce.openImportData",
        "title": "Import Data…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dittoVsce.openWelcome",
        "title": "Ditto: Welcome",
        "icon": "$(question)"
      },
      {
        "command": "dittoVsce.getQuickstarts",
        "title": "Ditto: Get Quickstarts…",
        "category": "Ditto"
      },
      {
        "command": "dittoVsce.setApplicationLogLevel",
        "title": "Ditto: Set Application Log Level"
      },
      {
        "command": "dittoVsce.setDittoSdkLogLevel",
        "title": "Ditto: Set Ditto SDK Log Level"
      },
      {
        "command": "dittoVsce.openOutputChannel",
        "title": "Ditto: Open Output Channel"
      },
      {
        "command": "dittoVsce.resetWarnings",
        "title": "Ditto: Reset Warnings",
        "icon": "$(refresh)"
      },
      {
        "command": "dittoVsce.exportLogs",
        "title": "Ditto: Export Logs for Bug Report…"
      },
      {
        "command": "dittoVsce.showLogFile",
        "title": "Ditto: Show Log File in Finder"
      },
      {
        "command": "dittoVsce.toggleInspector",
        "title": "Ditto: Toggle Inspector",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "dittoVsce.refreshCollections",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dittoVsce.queryAllInCollection",
        "title": "SELECT * FROM …"
      },
      {
        "command": "dittoVsce.addIndex",
        "title": "Add Index…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.deleteIndex",
        "title": "Delete Index",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "dittoVsce.toggleInspector",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dittoVsce.toggleInspector",
          "group": "navigation",
          "when": "activeWebviewPanelId =~ /^(dittoQueryEditor|dittoPeerListing|dittoSubscriptionEditor)$/"
        }
      ],
      "view/title": [
        {
          "command": "dittoVsce.registerDatabase",
          "when": "view == dittoDatabases",
          "group": "navigation"
        },
        {
          "command": "dittoVsce.openWelcome",
          "when": "view == dittoDatabases",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "dittoVsce.openWelcome"
        }
      ],
      "view/item/context": [
        {
          "command": "dittoVsce.connect",
          "when": "view == dittoDatabases && viewItem == database.idle",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.connect",
          "when": "view == dittoDatabases && viewItem == database.error",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.disconnect",
          "when": "view == dittoDatabases && viewItem == database.active",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.editDatabase",
          "when": "view == dittoDatabases && viewItem =~ /^database\\./",
          "group": "2_edit@1"
        },
        {
          "command": "dittoVsce.deleteDatabase",
          "when": "view == dittoDatabases && viewItem =~ /^database\\./",
          "group": "2_edit@2"
        },
        {
          "command": "dittoVsce.newSubscription",
          "when": "view == dittoDatabases && viewItem == subscriptionsParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.editSubscription",
          "when": "view == dittoDatabases && viewItem == subscription",
          "group": "1@0"
        },
        {
          "command": "dittoVsce.deleteSubscription",
          "when": "view == dittoDatabases && viewItem == subscription",
          "group": "1@1"
        },
        {
          "command": "dittoVsce.newObserver",
          "when": "view == dittoDatabases && viewItem == observersParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.newObserver",
          "when": "view == dittoDatabases && viewItem == observersParent",
          "group": "1_new@1"
        },
        {
          "command": "dittoVsce.editObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "1_edit@1"
        },
        {
          "command": "dittoVsce.deleteObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "9_destructive@1"
        },
        {
          "command": "dittoVsce.deleteObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "inline"
        },
        {
          "command": "dittoVsce.refreshCollections",
          "when": "view == dittoDatabases && viewItem == databaseDetails",
          "group": "inline"
        },
        {
          "command": "dittoVsce.refreshCollections",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "dittoVsce.queryAllInCollection",
          "when": "view == dittoDatabases && viewItem == documentsLeaf",
          "group": "1_open@1"
        },
        {
          "command": "dittoVsce.queryAllInCollection",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "1_open@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "2_index@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == indexesParent",
          "group": "2_index@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == indexesParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.deleteIndex",
          "when": "view == dittoDatabases && viewItem == index",
          "group": "9_destructive@1"
        },
        {
          "command": "dittoVsce.deleteIndex",
          "when": "view == dittoDatabases && viewItem == index",
          "group": "inline"
        },
        {
          "command": "dittoVsce.openImportData",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "3_import@1"
        }
      ]
    },
    "configuration": {
      "title": "Ditto",
      "properties": {
        "dittoVsce.collectProfiling": {
          "type": "boolean",
          "default": true,
          "description": "Capture PROFILE execution-plan envelopes for local SELECT queries. When off, the Profile view tab is hidden and SELECTs run without the PROFILE prefix (no profile overhead)."
        },
        "dittoVsce.collectMetrics": {
          "type": "boolean",
          "default": true,
          "description": "Capture EXPLAIN plans and duration metrics for queries. When off, the Metrics tab in the Inspector and the Query Metrics panel are hidden, and queries run without the EXPLAIN side-trip (no metrics overhead)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:integration": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node --import tsx --import ./scripts/register-vscode-stub.mjs --test 'src/test/**/*.test.ts'",
    "test:integration:load": "DITTO_CI_DEPTH=load node dist/test/integration/runTests.js",
    "test:integration:e2e": "DITTO_CI_DEPTH=e2e DITTO_CI_MODE=1 node dist/test/integration/runTests.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --target ${TARGET:?TARGET env var must be set, e.g. darwin-arm64}"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.23.0",
    "glob": "^13.0.6",
    "lit": "^3.3.2",
    "markdown-it": "^14.1.1",
    "mocha": "^11.7.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@dittolive/ditto": "^5.0.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "serialize-javascript": "^7.0.5"
  }
}
