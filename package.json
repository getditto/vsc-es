{
  "name": "ditto-vsce",
  "displayName": "Ditto Edge Studio",
  "description": "Debug and inspect Ditto databases from VS Code.",
  "version": "0.9.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getditto/vsc-es.git"
  },
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "publisher": "ditto",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "homepage": "https://github.com/getditto/vsc-es#readme",
  "bugs": {
    "url": "https://github.com/getditto/vsc-es/issues"
  },
  "qna": "https://github.com/getditto/vsc-es/issues",
  "categories": [
    "Debuggers",
    "Visualization",
    "Testing",
    "Other"
  ],
  "keywords": [
    "ditto",
    "sync",
    "crdt",
    "offline-first",
    "dql",
    "edge",
    "peer-to-peer",
    "database"
  ],
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      { "id": "ditto-edge-studio", "label": "Ditto Edge Studio" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dittoVsce",
          "title": "Ditto",
          "icon": "resources/ditto-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dittoInspector",
          "title": "Ditto Inspector",
          "icon": "resources/ditto-icon.svg"
        }
      ]
    },
    "views": {
      "dittoVsce": [
        {
          "id": "dittoDatabases",
          "name": "Connections"
        },
        {
          "id": "dittoLogging",
          "name": "Logging"
        },
        {
          "id": "dittoHelp",
          "name": "Help"
        }
      ],
      "dittoInspector": [
        {
          "type": "webview",
          "id": "dittoVsce.inspector",
          "name": "Inspector"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dittoDatabases",
        "contents": "No Ditto connections yet.\n\nNew to Ditto? Take the guided tour to set up your first connection.\n[Open Welcome](command:dittoVsce.openWelcome)\n\nAlready have Portal credentials?\n[Register Connection…](command:dittoVsce.registerDatabase)"
      }
    ],
    "commands": [
      {
        "command": "dittoVsce.registerDatabase",
        "title": "Ditto: Register Connection…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.editDatabase",
        "title": "Edit Configuration",
        "icon": "$(edit)"
      },
      {
        "command": "dittoVsce.deleteDatabase",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.connect",
        "title": "Connect"
      },
      {
        "command": "dittoVsce.disconnect",
        "title": "Disconnect"
      },
      {
        "command": "dittoVsce.openPeerListing",
        "title": "Open Peer Listing"
      },
      {
        "command": "dittoVsce.newSubscription",
        "title": "Ditto: New Subscription…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.deleteSubscription",
        "title": "Delete Subscription",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.editSubscription",
        "title": "Edit Subscription",
        "icon": "$(edit)"
      },
      {
        "command": "dittoVsce.newObserver",
        "title": "Ditto: New Observer…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.editObserver",
        "title": "Edit Observer"
      },
      {
        "command": "dittoVsce.deleteObserver",
        "title": "Delete Observer",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.openObserver",
        "title": "Open Observer"
      },
      {
        "command": "dittoVsce.importSubscriptionsFromServer",
        "title": "Ditto: Import Subscriptions from Server…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dittoVsce.openQueryEditor",
        "title": "Open Query Editor"
      },
      {
        "command": "dittoVsce.openQueryMetrics",
        "title": "Open Query Metrics",
        "icon": "$(dashboard)"
      },
      {
        "command": "dittoVsce.openDatabaseMetrics",
        "title": "Open Database Metrics",
        "icon": "$(pie-chart)"
      },
      {
        "command": "dittoVsce.openSystemMetrics",
        "title": "Open System Metrics",
        "icon": "$(pulse)"
      },
      {
        "command": "dittoVsce.openImportData",
        "title": "Import Data…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dittoVsce.openDebugConsole",
        "title": "Ditto: Open Debug Console",
        "icon": "$(terminal)"
      },
      {
        "command": "dittoVsce.openWelcome",
        "title": "Ditto: Welcome",
        "icon": "$(question)"
      },
      {
        "command": "dittoVsce.getQuickstarts",
        "title": "Ditto: Get Quickstarts…",
        "category": "Ditto"
      },
      {
        "command": "dittoVsce.setApplicationLogLevel",
        "title": "Ditto: Set Application Log Level"
      },
      {
        "command": "dittoVsce.setDittoSdkLogLevel",
        "title": "Ditto: Set Ditto SDK Log Level"
      },
      {
        "command": "dittoVsce.openOutputChannel",
        "title": "Ditto: Open Output Channel"
      },
      {
        "command": "dittoVsce.resetWarnings",
        "title": "Ditto: Reset Warnings",
        "icon": "$(refresh)"
      },
      {
        "command": "dittoVsce.exportLogs",
        "title": "Ditto: Export Logs for Bug Report…"
      },
      {
        "command": "dittoVsce.showLogFile",
        "title": "Ditto: Show Log File in Finder"
      },
      {
        "command": "dittoVsce.toggleInspector",
        "title": "Ditto: Toggle Inspector",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "dittoVsce.refreshCollections",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dittoVsce.queryAllInCollection",
        "title": "SELECT * FROM …"
      },
      {
        "command": "dittoVsce.addIndex",
        "title": "Add Index…",
        "icon": "$(add)"
      },
      {
        "command": "dittoVsce.deleteIndex",
        "title": "Delete Index",
        "icon": "$(trash)"
      },
      {
        "command": "dittoVsce.openLogAnalyzer",
        "title": "Ditto: Open Log Analyzer",
        "icon": "$(search)"
      },
      {
        "command": "dittoVsce.openLogPatternEditor",
        "title": "Ditto: Manage Log Patterns",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dittoVsce.mcpServerStart",
        "title": "Ditto: Start MCP Server"
      },
      {
        "command": "dittoVsce.mcpServerStop",
        "title": "Ditto: Stop MCP Server"
      },
      {
        "command": "dittoVsce.mcpServerStatus",
        "title": "Ditto: MCP Server Status"
      },
      {
        "command": "dittoVsce.mcpServerCopyConfig",
        "title": "Ditto: Copy MCP Client Config"
      }
    ],
    "keybindings": [
      {
        "command": "dittoVsce.toggleInspector",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dittoVsce.toggleInspector",
          "group": "navigation",
          "when": "activeWebviewPanelId =~ /^(dittoQueryEditor|dittoPeerListing|dittoSubscriptionEditor)$/"
        }
      ],
      "view/title": [
        {
          "command": "dittoVsce.registerDatabase",
          "when": "view == dittoDatabases",
          "group": "navigation"
        },
        {
          "command": "dittoVsce.openWelcome",
          "when": "view == dittoDatabases",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "dittoVsce.editDatabase",
          "when": "false"
        },
        {
          "command": "dittoVsce.deleteDatabase",
          "when": "false"
        },
        {
          "command": "dittoVsce.connect",
          "when": "false"
        },
        {
          "command": "dittoVsce.disconnect",
          "when": "false"
        },
        {
          "command": "dittoVsce.openPeerListing",
          "when": "false"
        },
        {
          "command": "dittoVsce.deleteSubscription",
          "when": "false"
        },
        {
          "command": "dittoVsce.editSubscription",
          "when": "false"
        },
        {
          "command": "dittoVsce.editObserver",
          "when": "false"
        },
        {
          "command": "dittoVsce.deleteObserver",
          "when": "false"
        },
        {
          "command": "dittoVsce.openObserver",
          "when": "false"
        },
        {
          "command": "dittoVsce.openQueryEditor",
          "when": "false"
        },
        {
          "command": "dittoVsce.openQueryMetrics",
          "when": "false"
        },
        {
          "command": "dittoVsce.openDatabaseMetrics",
          "when": "false"
        },
        {
          "command": "dittoVsce.openSystemMetrics",
          "when": "false"
        },
        {
          "command": "dittoVsce.openImportData",
          "when": "false"
        },
        {
          "command": "dittoVsce.refreshCollections",
          "when": "false"
        },
        {
          "command": "dittoVsce.queryAllInCollection",
          "when": "false"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "false"
        },
        {
          "command": "dittoVsce.deleteIndex",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "dittoVsce.connect",
          "when": "view == dittoDatabases && viewItem == database.idle",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.connect",
          "when": "view == dittoDatabases && viewItem == database.error",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.disconnect",
          "when": "view == dittoDatabases && viewItem == database.active",
          "group": "1_connection@1"
        },
        {
          "command": "dittoVsce.editDatabase",
          "when": "view == dittoDatabases && viewItem =~ /^database\\./",
          "group": "2_edit@1"
        },
        {
          "command": "dittoVsce.deleteDatabase",
          "when": "view == dittoDatabases && viewItem =~ /^database\\./",
          "group": "2_edit@2"
        },
        {
          "command": "dittoVsce.newSubscription",
          "when": "view == dittoDatabases && viewItem == subscriptionsParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.editSubscription",
          "when": "view == dittoDatabases && viewItem == subscription",
          "group": "1@0"
        },
        {
          "command": "dittoVsce.deleteSubscription",
          "when": "view == dittoDatabases && viewItem == subscription",
          "group": "1@1"
        },
        {
          "command": "dittoVsce.newObserver",
          "when": "view == dittoDatabases && viewItem == observersParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.newObserver",
          "when": "view == dittoDatabases && viewItem == observersParent",
          "group": "1_new@1"
        },
        {
          "command": "dittoVsce.editObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "1_edit@1"
        },
        {
          "command": "dittoVsce.deleteObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "9_destructive@1"
        },
        {
          "command": "dittoVsce.deleteObserver",
          "when": "view == dittoDatabases && viewItem == observer",
          "group": "inline"
        },
        {
          "command": "dittoVsce.refreshCollections",
          "when": "view == dittoDatabases && viewItem == databaseDetails",
          "group": "inline"
        },
        {
          "command": "dittoVsce.refreshCollections",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "dittoVsce.queryAllInCollection",
          "when": "view == dittoDatabases && viewItem == documentsLeaf",
          "group": "1_open@1"
        },
        {
          "command": "dittoVsce.queryAllInCollection",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "1_open@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "2_index@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == indexesParent",
          "group": "2_index@1"
        },
        {
          "command": "dittoVsce.addIndex",
          "when": "view == dittoDatabases && viewItem == indexesParent",
          "group": "inline"
        },
        {
          "command": "dittoVsce.deleteIndex",
          "when": "view == dittoDatabases && viewItem == index",
          "group": "9_destructive@1"
        },
        {
          "command": "dittoVsce.deleteIndex",
          "when": "view == dittoDatabases && viewItem == index",
          "group": "inline"
        },
        {
          "command": "dittoVsce.openImportData",
          "when": "view == dittoDatabases && viewItem == collection",
          "group": "3_import@1"
        }
      ]
    },
    "configuration": {
      "title": "Ditto",
      "properties": {
        "dittoVsce.collectProfiling": {
          "type": "boolean",
          "default": true,
          "description": "Capture PROFILE execution-plan envelopes for local SELECT queries. When off, the Profile view tab is hidden and SELECTs run without the PROFILE prefix (no profile overhead)."
        },
        "dittoVsce.collectMetrics": {
          "type": "boolean",
          "default": true,
          "description": "Capture EXPLAIN plans and duration metrics for queries. When off, the Metrics tab in the Inspector and the Query Metrics panel are hidden, and queries run without the EXPLAIN side-trip (no metrics overhead)."
        },
        "dittoVsce.collectSystemMetrics": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ditto's startup-gated system:metrics virtual collection for connections this extension opens (sets DITTO_METRICS_EXPORTER_VIRTUAL_COLLECTION_ENABLED around Ditto.open), feeding the System Metrics panel. Changes apply at the NEXT connect — the SDK parameter is startup-only."
        },
        "dittoVsce.mcpServer.port": {
          "type": "number",
          "default": 65270,
          "minimum": 0,
          "maximum": 65535,
          "scope": "machine",
          "description": "TCP port the MCP server binds on 127.0.0.1 (and ::1) while a connection with MCP Server enabled (Edit Configuration → Advanced) is active. Default 65270 — the SwiftUI Edge Studio app uses 65269, so both can run side by side. Applies immediately (restarts the listener when running) or on next start."
        },
        "dittoVsce.logAnalyzer.customPatternsFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a JSON file containing user-defined log analyzer patterns. Leave empty to use the editor's default location (globalStorage/log-analyzer/user_patterns.json). Machine-scoped: the extension reads this file and compiles its entries into regular expressions, so a workspace must not be able to point it somewhere."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Connection credentials, log analyzer patterns, and the SDK working directory are all machine-scoped and never read from workspace settings, but the extension loads the native Ditto SDK and writes to global storage. Trust the workspace before connecting.",
      "restrictedConfigurations": [
        "dittoVsce.logAnalyzer.customPatternsFile",
        "dittoVsce.mcpServer.port"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The Ditto SDK needs a real on-disk working directory, so connections are unavailable in virtual workspaces. The Log Analyzer works."
    }
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "validate": "npm run typecheck && npm run lint && npm test",
    "build:integration": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node --expose-gc --import tsx --import ./scripts/register-vscode-stub.mjs --test 'src/test/*.test.ts' 'src/test/webview/*.test.ts'",
    "injector:generate": "node scripts/test-injector/generate-data.mjs",
    "injector:run": "node scripts/test-injector/injector.mjs",
    "test:integration:load": "DITTO_CI_DEPTH=load node dist/test/integration/runTests.js",
    "test:integration:e2e": "DITTO_CI_DEPTH=e2e DITTO_CI_MODE=1 node dist/test/integration/runTests.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --target ${TARGET:?TARGET env var must be set, e.g. darwin-arm64}",
    "coverage": "node scripts/check-coverage.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "knip": "knip",
    "license-check": "license-checker --production --onlyAllow \"MIT;MIT*;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;Unlicense\"",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "security": "node scripts/security-check.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.4.0",
    "@types/vscode": "~1.106.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "license-checker": "^25.0.1",
    "lit": "^3.3.2",
    "markdown-it": "^15.0.0",
    "mocha": "^11.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "dependencies": {
    "@dittolive/ditto": "5.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "diff": "8.0.3",
    "esbuild": "$esbuild",
    "fast-uri": "3.1.6",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "markdown-it@^15.0.0": {
      "linkify-it": "6.1.0"
    },
    "qs": "6.16.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "0.2.7",
    "undici": "7.29.0"
  }
}
